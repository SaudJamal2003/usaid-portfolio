# Copy to .env and fill in. .env is gitignored — never commit real values.
# Generate secrets with: openssl rand -base64 32

# ---- Postgres -------------------------------------------------------------
POSTGRES_USER=cms
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio_cms
POSTGRES_PORT=55432

# Prisma connects through the host-published port above.
DATABASE_URL="postgresql://cms:change-me@localhost:55432/portfolio_cms?schema=public"

# ---- MinIO / object storage ----------------------------------------------
MINIO_ROOT_USER=cms-storage
MINIO_ROOT_PASSWORD=change-me-too
MINIO_BUCKET=portfolio-media
MINIO_PORT=59000
MINIO_CONSOLE_PORT=59001
MINIO_ENDPOINT=http://localhost:59000

# Public base URL for media. In production this is the domain the reverse
# proxy maps to MinIO, e.g. https://media.usaidux.space
MEDIA_PUBLIC_URL=http://localhost:59000/portfolio-media

# ---- Auth -----------------------------------------------------------------
# Signs the session cookie. Rotating this logs everyone out.
SESSION_SECRET=change-me-to-32-random-bytes
SESSION_TTL_HOURS=168

# Seeded owner account. Change the password on first login.
OWNER_EMAIL=usaid.ahmedmay@gmail.com
OWNER_PASSWORD=change-me-before-seeding

# ---- App ------------------------------------------------------------------
CMS_PORT=53000
# Origins allowed to call the public content API (the portfolio).
PUBLIC_CORS_ORIGINS=http://localhost:5173,https://www.usaidux.space
